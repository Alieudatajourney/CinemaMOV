# Monrovia Cinema Plus — environment configuration
# Copy to .env.local and adjust. No variables are required for a local demo.

# Signs staff/admin session cookies. 32+ random characters. If unset, a random secret is
# generated once and stored in .data/session-secret (local demo convenience only).
SESSION_SECRET=

# Where the demo persistence adapter stores its JSON database (server-side only).
MCP_DATA_FILE=.data/monrovia-cinema-plus.json

# Demo staff accounts (seeded on first start / reset). CHANGE before sharing any deployment.
DEMO_ADMIN_EMAIL=admin@monroviacinemaplus.demo
DEMO_ADMIN_PASSWORD=PlusAdmin#2026
DEMO_STAFF_EMAIL=staff@monroviacinemaplus.demo
DEMO_STAFF_PASSWORD=PlusStaff#2026

# Set to 0 to hide the demo credentials panel on /login.
DEMO_SHOW_CREDENTIALS=1

# `next start` marks cookies Secure. Browsers accept that on http://localhost, but if you present
# from another device over plain http on a LAN IP, set this to 1 (never on a public deployment).
MCP_INSECURE_COOKIES=0

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For; otherwise forwarding
# headers are ignored for rate limiting (they are client-controlled).
MCP_TRUST_PROXY=0

# Set to 1 to make the server refuse to start without SESSION_SECRET in production.
MCP_REQUIRE_SECRET=0

# Used only by the automated end-to-end tests.
# MCP_DISABLE_RATE_LIMIT=1
